# 公网反代示例（B6）：把 8319 挂到 443
# 用法：替换 server_name 与证书路径后，放入 sites-enabled 并 reload nginx。
#
#   sudo ln -s /path/to/nginx-firesage.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name firesage.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name firesage.example.com;

    # ssl_certificate     /etc/letsencrypt/live/firesage.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/firesage.example.com/privkey.pem;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:8319;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
