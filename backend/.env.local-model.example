# 复制为 .env.local-model 后使用（run_firesage_local.py 读取）。
# 本地 LoRA 栈专用：指向 serve_local_qwen.py 启动的 OpenAI 兼容服务（默认 8320）。
# 与 .env.local（云端 DeepSeek）互不干扰，停掉本地进程即回退云端。
LLM_BASE_URL=http://127.0.0.1:8320/v1
LLM_API_KEY=local-firesage
LLM_MODEL=firesage-qwen25-3b-lora-v2
# 比赛演示默认限制异常长回答；需要做长答案评测时可临时改回 700
LLM_TIMEOUT=120
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=480
# 动态生成预算：普通题340、复杂题420、应急题220；完整 JSON 后提前停止。
# 设 LOCAL_LLM_FAST_MODE=0 可一键回退旧的统一上限行为。
LOCAL_LLM_FAST_MODE=1
LOCAL_LLM_SIMPLE_TOKENS=340
LOCAL_LLM_COMPLEX_TOKENS=420
LOCAL_LLM_EMERGENCY_TOKENS=220
LOCAL_LLM_RETRY_TOKENS=280
# 引用守卫最终返回的单条原文摘录长度；法规名和条号始终完整保留。
LOCAL_LLM_CITATION_CHARS=80
# 4060 上使用 PyTorch SDPA + KV cache；如环境不兼容可临时改为 eager。
LOCAL_LLM_ATTN_IMPL=sdpa
# 0=确定性贪心解码，结果稳定且略快；大于 0 才启用随机采样
LLM_TEMPERATURE=0
# 只把重排后的前三条送入模型，完整检索结果仍保留在前端证据区
LLM_CONTEXT_ARTICLES=3
# 开启流式输出（serve_local_qwen SSE）：记录首字响应时间 TTFT
LLM_STREAM=1
# CrossEncoder 精排后端：onnx_int8 = ONNX Runtime INT8 CPU（需先运行
# scripts/export_reranker_onnx.py 生成 backend/models/bge-reranker-v2-m3-onnx-int8）
# 不设置则用 PyTorch fp32（GPU 可见时自动上 GPU，会与 Qwen 抢显存）
RERANK_BACKEND=onnx_int8

# 启动方式（backend 目录，两个终端）：
#   ..\venv311\Scripts\python.exe scripts\serve_local_qwen.py --api-key local-firesage
#   ..\venv311\Scripts\python.exe scripts\run_firesage_local.py
# 服务地址：http://127.0.0.1:8321（生产 8319 不受影响）
