# 复制为 .env.local 后填写。不要将真实密钥提交到 Git。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=1          # 默认 1，避免超时后再等一轮
# LLM_MAX_TOKENS=480
# LLM_TEMPERATURE=0
# LLM_CONTEXT_ARTICLES=3     # 送给模型的条款数（展示引用仍可更多）
# CE_CANDIDATES=6            # CrossEncoder 只精排前 N 条
# VERIFY_REGENERATE=0        # 1=核验失败再调一次 LLM（更慢）

# 可选安全（试点）
# API_KEY=your-secret
# RATE_LIMIT_PER_MIN=60
# AUDIT_DIR=  # 默认 backend/data/audit
# AUDIT_DISABLED=0

# Docker / 演示轻量：1=跳过 bge 下载，TF-IDF 降级（默认 compose 已开）
# FIRESAGE_LITE=1

# 全量质量自检：
#   python3 backend/scripts/check_runtime.py
#   python3 backend/scripts/check_runtime.py --ping-llm --strict
